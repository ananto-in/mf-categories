{
    "name": "ananto-in/mf-categories",
    "description": "Open reference data for Indian mutual fund scheme categories: SEBI's categorization with stable IDs, characteristics, AMFI label aliases and change history.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sebi", "amfi", "mutual-funds", "india", "fintech", "open-data"],
    "homepage": "https://github.com/ananto-in/mf-categories",
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Ananto\\MfCategories\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ananto\\MfCategories\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 src/php"
    },
    "config": {
        "sort-packages": true
    }
}
