{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ananto-in/mf-categories/data/schema/glide-paths.schema.json",
  "title": "Glide paths",
  "description": "Life Cycle Fund asset allocation by years to maturity, per fund tenure.",
  "type": "object",
  "required": [
    "glide_paths"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "glide_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "circular",
          "bands"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,2}$"
          },
          "circular": {
            "type": "string",
            "minLength": 1
          },
          "bands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "years_to_maturity",
                "equity_pct",
                "debt_pct"
              ],
              "additionalProperties": false,
              "properties": {
                "years_to_maturity": {
                  "$ref": "#/$defs/range"
                },
                "equity_pct": {
                  "$ref": "#/$defs/range"
                },
                "debt_pct": {
                  "$ref": "#/$defs/range"
                },
                "gold_silver_etf_etcd_invit_pct": {
                  "$ref": "#/$defs/range"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    }
  }
}
