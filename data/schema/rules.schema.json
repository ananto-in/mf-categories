{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ananto-in/mf-categories/data/schema/rules.schema.json",
  "title": "Rules",
  "description": "Cross-category rules, e.g. portfolio overlap limits and per-fund-house limits.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "applies_to", "circular", "parameters"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$" }
          },
          "circular": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "parameters": { "type": "object" }
        }
      }
    }
  }
}
